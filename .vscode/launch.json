{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: Debug with args",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/trade-service",
      "args": [
        "--config",
        "${workspaceFolder}/config.toml",
        "-v"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo: build",
      "env": {
        "RUST_LOG": "debug",
        "RUST_BACKTRACE": "full"
      },
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}