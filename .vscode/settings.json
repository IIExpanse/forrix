{
    "conventionalCommits.scopes": [
        "control",
        "forrix",
        "market-data",
        "shared"
    ],
    "rust-analyzer.check.command": "clippy",
    "rust-analyzer.cargo.features": "all",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "todo-tree.general.tags": [
        "BUG",
        "HACK",
        "FIXME",
        "TODO",
        "XXX",
        "[ ]",
        "[x]",
        "todo"
    ]
}